# Copy to .env, then replace these values for your deployment.
# 0.0.0.0 publishes the service on every host interface.
KALI_MCP_BIND_IP=0.0.0.0

# Host-side published port; the container continues to listen on 8000.
KALI_MCP_HOST_PORT=27180

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This placeholder is intentionally not a valid hex token.
KALI_MCP_API_TOKEN=<generate-a-64-hex-character-token>
